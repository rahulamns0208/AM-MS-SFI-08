PORT=3000
# On a persistent host volume, point both paths to that volume. Render example: /var/data
DATA_DIR=./data
UPLOAD_DIR=./uploads
# Paste the Power Automate trigger URL. Keep it secret; do not put it in frontend HTML or GitHub.
PA_WEBHOOK_URL=
# Optional shared secret header. If used, validate x-sfi-secret in your flow/gateway.
PA_SHARED_SECRET=
